# ===========================================================================
# Advanced-RAG-System  |  environment template
#
#   cp .env.example .env    then fill in the blanks.
#   .env is gitignored. This file is committed and must never hold a secret.
#
# Every retrieval knob below is deliberately configurable rather than
# hard-coded, because PRD 5.5 requires index and pipeline configuration to be
# measurable. If you find yourself editing a constant in code to run an
# experiment, it belongs here instead.
# ===========================================================================

# ---------------------------------------------------------------------------
# Service
# ---------------------------------------------------------------------------
ENV=local                          # local | dev | prod
LOG_LEVEL=info                     # debug | info | warning | error
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_PATH=/api/v1

# ---------------------------------------------------------------------------
# Postgres  (rag_db)
# Source of truth. Owns documents, chunks, ingestion jobs, outbox, evals.
# No other system may connect to this database. See PRD 10.1.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://rag:changeme@localhost:5432/rag_db
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=20
DB_STATEMENT_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Qdrant
# Owned exclusively by this system. Nothing else connects to it.
# Keep a flat collection alongside the HNSW one: it is the ground truth
# Recall@K is measured against, and without it the metric is undefined.
# ---------------------------------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_GRPC_PORT=6334
QDRANT_API_KEY=                    # empty locally, required in the cluster
QDRANT_COLLECTION=chunks
QDRANT_FLAT_COLLECTION=chunks_flat
QDRANT_TIMEOUT_S=10

# HNSW build parameters. Changing these requires a full reindex.
HNSW_M=16                          # edges per node. higher = better recall, more RAM
HNSW_EF_CONSTRUCT=128              # build quality. higher = slower build
HNSW_FULL_SCAN_THRESHOLD=10000     # below this many points Qdrant does brute force.
                                   # NOTE: a 5K-vector corpus never uses HNSW at all.

# Query-time parameter. Tunable per request without a rebuild.
# This is the recall/latency dial. Sweep it first (PRD 7.4, Experiment 1).
HNSW_EF_SEARCH=128

# Quantization: none | scalar | product | binary
# scalar is usually a near-free 4x memory reduction for about a point of recall.
QUANTIZATION=none
QUANTIZATION_ALWAYS_RAM=true
QUANTIZATION_RESCORE=true          # fetch full vectors for the top N and rescore exactly
QUANTIZATION_RESCORE_LIMIT=100

# ---------------------------------------------------------------------------
# Embeddings  (TEI, or any OpenAI-compatible embedding endpoint)
# EMBEDDING_MODEL is recorded on every vector row so stale vectors can be
# found and re-embedded incrementally when the model changes.
# ---------------------------------------------------------------------------
EMBEDDING_URL=http://localhost:8081
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=64
EMBEDDING_TIMEOUT_S=30
EMBEDDING_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Reranker  (cross-encoder)
# The largest single quality jump in the pipeline, and also the most expensive
# stage after generation. Keep it switchable so the delta stays measurable.
# ---------------------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_URL=http://localhost:8082
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_TOP_N=100                 # candidates in
RERANKER_RETURN_N=5                # passages out
RERANKER_TIMEOUT_S=10

# ---------------------------------------------------------------------------
# Inference  (Distributed-Inference-Serving)
# The only cross-system dependency. Reached over HTTP, never imported.
# When this is unreachable, retrieval must still answer with citations and
# answer: null plus a degraded flag. See PRD Section 5 degradation contract.
# ---------------------------------------------------------------------------
INFERENCE_URL=http://localhost:8080/v1
INFERENCE_MODEL=qwen3.6-35b-a3b
INFERENCE_API_KEY=
INFERENCE_WORKLOAD_CLASS=rag       # routes to the throughput pool

# Three separate timeouts. They are three different failures.
INFERENCE_CONNECT_TIMEOUT_S=5
INFERENCE_FIRST_TOKEN_TIMEOUT_S=30
INFERENCE_TOTAL_TIMEOUT_S=300

# Retries only ever happen before the first token. Never retry a stream that
# has already emitted output, it duplicates the answer.
INFERENCE_MAX_RETRIES=2
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_S=30

# ---------------------------------------------------------------------------
# Retrieval pipeline
# ---------------------------------------------------------------------------
QUERY_REWRITE_ENABLED=true         # switch off to A/B against direct retrieval
QUERY_REWRITE_STRATEGY=standalone  # standalone | expansion | multi_query | decompose

TOP_K_DENSE=100
TOP_K_SPARSE=100
SPARSE_ENABLED=true

FUSION_STRATEGY=rrf                # rrf | weighted
RRF_K=60                           # the RRF constant
FUSION_DENSE_WEIGHT=0.5            # weighted mode only
FUSION_SPARSE_WEIGHT=0.5

MMR_ENABLED=true
MMR_LAMBDA=0.7                     # 1.0 = pure relevance, 0.0 = pure diversity
MMR_TOP_N=20

# ---------------------------------------------------------------------------
# Context builder
# ---------------------------------------------------------------------------
MAX_CONTEXT_TOKENS=100000          # hard cap. oversized prompts are rejected, not truncated
CONTEXT_RESERVE_TOKENS=2000        # headroom for the answer
DEDUPE_THRESHOLD=0.95              # cosine above this counts as a near-duplicate
MAX_CHUNKS_PER_DOCUMENT=3          # source diversity

# ---------------------------------------------------------------------------
# Chunking
# Freeze these before the full 1.5M backfill. Changing them invalidates every
# embedding you have paid for.
# ---------------------------------------------------------------------------
CHUNK_STRATEGY=section_aware       # fixed | sentence_aware | section_aware
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
MIN_CHUNK_TOKENS=32                # drop fragments shorter than this

# ---------------------------------------------------------------------------
# Ingestion workers
# ---------------------------------------------------------------------------
INGESTION_WORKER_CONCURRENCY=4
INGESTION_BATCH_SIZE=1000
INGESTION_MAX_ATTEMPTS=3           # then dead letter, never retry forever
INGESTION_STUCK_JOB_TIMEOUT_MIN=30 # the reaper resets jobs stuck in processing

OUTBOX_POLL_INTERVAL_S=2
OUTBOX_BATCH_SIZE=500

DEDUPE_BY_HASH=true                # skip embedding chunks with an identical sha256.
                                   # year-over-year filings repeat 10 to 25 percent.

# ---------------------------------------------------------------------------
# Object storage  (raw documents)
# ---------------------------------------------------------------------------
GCS_BUCKET=big-project-llm-documents
GCS_PREFIX=filings/
# Locally only. In the cluster use Workload Identity and set nothing here.
GOOGLE_APPLICATION_CREDENTIALS=

# ---------------------------------------------------------------------------
# Multi-tenancy and partitioning
# Set these from day one even with a single value. Retrofitting a partition
# key means a full reindex.
# ---------------------------------------------------------------------------
DEFAULT_TENANT=default
TENANT_PAYLOAD_INDEX=true          # groups storage by tenant, cheap and worth it
PARTITIONING_ENABLED=false         # turn on only where Experiment 5 says so
PARTITION_KEY=sector               # sector | year | tenant

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
JWT_ISSUER=https://auth.example.com
JWT_AUDIENCE=rag-api
JWKS_URL=https://auth.example.com/.well-known/jwks.json
AUTH_ENABLED=false                 # false locally only

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_QUERIES_PER_MINUTE=120
RATE_LIMIT_UPLOADS_PER_HOUR=100
MAX_CONCURRENT_QUERIES=32

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
OTEL_SERVICE_NAME=advanced-rag-system
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER_ARG=1.0        # 1.0 locally, lower in production
METRICS_ENABLED=true
METRICS_PATH=/metrics

# ---------------------------------------------------------------------------
# Evaluation
# ---------------------------------------------------------------------------
EVAL_GROUND_TRUTH_COLLECTION=chunks_flat
EVAL_QUERY_SET_PATH=evaluation/fixtures/queries.jsonl
EVAL_K_VALUES=1,5,10,50
EVAL_RESULTS_DIR=evaluation/results

# ---------------------------------------------------------------------------
# Local backends (no GPU, no TEI service needed)
# EMBEDDING_BACKEND / RERANKER_BACKEND select how vectors are produced:
#   tei       -> HTTP call to EMBEDDING_URL / RERANKER_URL (production)
#   fastembed -> in-process ONNX on CPU (local dev; model auto-downloads)
#   hash      -> deterministic garbage vectors (unit tests only)
# The bulk 1.5M-chunk backfill runs neither: it goes through Modal H100s
# (modal_app/embed_backfill.py) and lands in chunk_vectors via the outbox.
# ---------------------------------------------------------------------------
EMBEDDING_BACKEND=fastembed
RERANKER_BACKEND=fastembed

# BM25 (hand-written sparse retrieval, PRD 3.4)
BM25_K1=1.2
BM25_B=0.75
