          "tags": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tags",
            "default": []
          },
          "meta": {
            "additionalProperties": true,
            "type": "object",
            "title": "Meta",
            "default": {}
          }
        },
        "type": "object",
        "required": [
          "name"
        ],
        "title": "DocumentIn",
        "description": "Register a document already sitting in GCS (the EDGAR flow), or send\ninline text for small ad-hoc documents."
      },
      "EvalRequest": {
        "properties": {
          "config_name": {
            "type": "string",
            "title": "Config Name",
            "default": "default"
          },
          "k_values": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "K Values",
            "default": [
              1,
              5,
              10
            ]
