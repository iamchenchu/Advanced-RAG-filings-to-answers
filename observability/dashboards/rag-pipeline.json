{
 "title": "RAG Pipeline",
 "uid": "rag-pipeline",
 "timezone": "browser",
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Stage latency p95 - the whole pipeline on one panel",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "Prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, sum by (le, stage) (rate(rag_stage_duration_seconds_bucket[5m])))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Stage latency p50",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "Prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.50, sum by (le, stage) (rate(rag_stage_duration_seconds_bucket[5m])))",
     "legendFormat": "{{stage}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Queries per second by status",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "Prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "sum by (status) (rate(rag_queries_total[5m]))",
     "legendFormat": "{{status}}",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "SILENT-FAILURE gauge: ingestion jobs pending",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "Prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rag_ingestion_jobs_pending",
     "legendFormat": "pending jobs",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "SILENT-FAILURE gauge: outbox pending (Qdrant sync lag)",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "Prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "rag_outbox_pending_total",
     "legendFormat": "pending sync",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Rerank score distribution (drift watch)",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "Prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.5, rate(rag_rerank_score_bucket[15m]))",
     "legendFormat": "median",
     "refId": "A"
    },
    {
     "expr": "histogram_quantile(0.9, rate(rag_rerank_score_bucket[15m]))",
     "legendFormat": "p90",
     "refId": "B"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Context tokens per query (creep watch)",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "Prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 8
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "expr": "histogram_quantile(0.95, rate(rag_context_tokens_bucket[15m]))",
     "legendFormat": "p95 tokens",
     "refId": "A"
    }
   ],
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    }
   }
  }
 ]
}